# Python
#
# The directory names below are Python build artefacts, and several of them —
# lib, build, dist, parts — are also ordinary names inside a source tree. Left
# unanchored they match at any depth, which is how `lib/` silently excluded
# `frontend/src/lib/` and shipped a frontend that could not compile. Anchored
# with a leading slash they mean the repository root and nothing else; the
# per-directory artefacts are listed explicitly.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/lib/
/lib64/
/parts/
backend/build/
backend/dist/
backend/var/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Jupyter
.ipynb_checkpoints/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build
frontend/dist/
frontend/build/
.next/

# Environment variables
.env
.env.local
.env.*.local
*.env

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Docker
.docker/

# Redis
dump.rdb

# Uploads (user data)
#
# `*.csv` is deliberately broad — response data is the one thing that must never
# reach a public repository by accident. The exceptions are the two sets of CSVs
# that are source, not data: the example datasets, and the mirt agreement
# fixtures, which have to be committed because regenerating them invalidates the
# stored reference fits they are compared against.
uploads/
*.csv
!examples/sample_datasets/*.csv
!backend/tests/validation/fixtures/*.csv

# R
.Rhistory
.Rdata
.RData

# Temporary files
*.tmp
*.temp
.temp/
tmp/

# venv
backend/.venv/
